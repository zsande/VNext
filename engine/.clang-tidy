# The checks clang-tidy runs on the engine (sh engine/tests/tidy.sh), and what's left out, and why:
#   bugprone-easily-swappable-parameters: x, y, w and h side by side are what drawing takes
#   bugprone-narrowing-conversions: -Wconversion checks it already
#   bugprone-switch-missing-default-case: switches go over every kind (the compiler says when one's missing)
#   bugprone-implicit-widening-of-multiplication-result: small sizes and pixel sums
#   bugprone-branch-clone: branches that read alike on purpose (each kind in its own words)
#   bugprone-unchecked-optional-access: it can't follow the checks made before (the script parser's, the lists')
#   bugprone-optional-value-conversion: *x put into an optional, inside if (x)
#   bugprone-assignment-in-if-condition: timers counted down in their test, (t -= dt) <= 0
#   bugprone-integer-division: grid rows (index / columns) are whole numbers on purpose
#   bugprone-float-loop-counter: loops that step a scroll or a list along by distances, not counts
#   bugprone-signed-bitwise: shifts by counts like 8 * i, small and never negative
#   misc-multiple-inheritance: Overloaded (std::visit's helper) inherits its lambdas
#   misc-non-private-member-variables-in-classes, misc-include-cleaner, misc-no-recursion,
#   misc-const-correctness, performance-enum-size, performance-avoid-endl,
#   performance-inefficient-string-concatenation: more noise than help here
# Exceptions getting out: destructors, main and noexcept functions are checked; lambdas' moves aren't (one
# that copies a captured string is reported as if it had to be noexcept).
Checks: >-
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-switch-missing-default-case,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-branch-clone,
  -bugprone-unchecked-optional-access,
  -bugprone-optional-value-conversion,
  -bugprone-assignment-in-if-condition,
  -bugprone-integer-division,
  -bugprone-float-loop-counter,
  -bugprone-signed-bitwise,
  clang-analyzer-*,
  -clang-analyzer-osx.*,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-optin.osx.*,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  cppcoreguidelines-slicing,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-missing-std-forward,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-interfaces-global-init,
  performance-*,
  -performance-enum-size,
  -performance-avoid-endl,
  -performance-inefficient-string-concatenation,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-make-unique,
  modernize-redundant-void-arg,
  modernize-use-bool-literals,
  modernize-deprecated-headers,
  misc-*,
  -misc-multiple-inheritance,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-const-correctness,
  readability-container-size-empty,
  readability-redundant-string-cstr,
  readability-redundant-smartptr-get,
  readability-make-member-function-const,
  readability-static-accessed-through-instance,
  readability-inconsistent-declaration-parameter-name,
  readability-non-const-parameter,
  readability-misleading-indentation,
  readability-duplicate-include
CheckOptions:
  bugprone-exception-escape.CheckMoveMemberFunctions: false
  bugprone-unused-return-value.AllowCastToVoid: true
HeaderFilterRegex: '.*/engine/src/.*'
